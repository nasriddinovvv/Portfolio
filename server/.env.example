# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Frontend origins allowed to call this API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite file, relative to the server/ folder. Created automatically.
DATABASE_PATH=data/portfolio.db

# ── Admin panel ───────────────────────────────────────────────────────────────
# Sign your own secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Used only the first time the database is created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# Mixed into visitor hashes so raw IPs are never stored.
ANALYTICS_SALT=change-me-too

# ── AI chatbot (required for /api/chat) ───────────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5
CHAT_MAX_TOKENS=1024

# ── Email notifications (optional) ────────────────────────────────────────────
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
