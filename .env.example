# Frontend environment (optional — defaults work for local development).

# Where the browser sends API calls. Leave unset in dev: Vite proxies /api
# to the backend automatically. Set this when the API lives on another host.
# VITE_API_URL=https://api.example.com/api

# Backend address the Vite dev proxy forwards /api to.
# VITE_API_PROXY=http://localhost:4000
